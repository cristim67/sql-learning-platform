# Single .env for this app (server + Docker client build). Copy to .env and fill in.

# Database (Neon or any PostgreSQL)
DATABASE_URL="postgresql://user:password@host/dbname?channel_binding=require&sslmode=require"

# Server
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
ENCRYPTION_KEY="your-64-hex-chars-or-any-secret-min-16-chars"
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
PORT=3001
FRONTEND_ORIGIN="http://localhost:5173"

# Optional: Bearer token for api.genez.io (used by "Generate database")
# GENEZIO_TOKEN="eyJ..."
# Optional: if Genezio returns "Please update your client", set Accept-Version (e.g. genezio-webapp/2.0)
# GENEZIO_ACCEPT_VERSION="genezio-webapp/1.0"

# Client build (same as GOOGLE_CLIENT_ID; used when running docker compose)
VITE_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
